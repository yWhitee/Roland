DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here
DISCORD_GUILD_ID=your_server_id_here
DISCORD_PUBLIC_KEY=your_public_key_here

# Roblox OAuth 2.0 (Creator Dashboard > OAuth 2.0 Apps). Verification stays disabled until all three are set.
ROBLOX_CLIENT_ID=your_roblox_oauth_client_id
ROBLOX_CLIENT_SECRET=your_roblox_oauth_client_secret
ROBLOX_REDIRECT_URI=https://your-public-domain.example/oauth/roblox/callback

# Local HTTP server that receives the Roblox OAuth callback. Expose it publicly over HTTPS (reverse proxy or tunnel).
OAUTH_SERVER_HOST=127.0.0.1
OAUTH_SERVER_PORT=3000
